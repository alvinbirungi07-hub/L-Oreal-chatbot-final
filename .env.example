# Optional: Server-side Gemini API key (used by default with Google Search grounding)
GEMINI_API_KEY=

# Optional: Server-side OpenAI API key (used when calling OpenAI directly)
OPENAI_API_KEY=

# Optional: Deployed Cloudflare Worker URL (e.g., https://loreal-routine-worker.your-subdomain.workers.dev)
CLOUDFLARE_WORKER_URL=
